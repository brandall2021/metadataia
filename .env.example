# ====================================================================
# METADATAIA - Variables de entorno (desarrollo)
# Copiar a .env y ajustar. NUNCA subir .env con claves reales a Git.
# ====================================================================

# --- Entorno ---------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=clave-desarrollo-metadataia-32-caracteres-minimo

# --- Base de datos ----------------------------------------------------
POSTGRES_USER=metadataia
POSTGRES_PASSWORD=metadataia
POSTGRES_DB=metadataia
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://metadataia:metadataia@postgres:5432/metadataia

# --- Redis / Celery ----------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3) --------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=metadataia
MINIO_SECRET_KEY=metadataia-secret
MINIO_BUCKET=metadataia
MINIO_ENDPOINT=minio:9000
STORAGE_BACKEND=s3

# --- JWT ----------------------------------------------------------------
JWT_SECRET=clave-jwt-desarrollo-metadataia-32-caracteres-minimo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Puertos de aplicacion ------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000

# --- Reglas generales ------------------------------------------------------
DEFAULT_MAX_FILE_SIZE_MB=100
OCR_LANGUAGES=spa+eng+por
AI_TIMEOUT_SECONDS=120
DSPACE_TIMEOUT_SECONDS=120
AUTO_OCR=true
AUTO_AI=true

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000