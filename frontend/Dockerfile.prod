# Imagen de PRODUCCION del frontend (FASE 18): build + servidor Next.
# API_INTERNAL_URL (destino interno del rewrite /api) se hornea en el build via args.
# NEXT_PUBLIC_API_URL es OPCIONAL: si se omite, el navegador usa el mismo origen
# (window.location.origin) y el rewrite de Next resuelve /api -> backend. Esto
# evita que un dominio vencido o distinto en el env rompa las llamadas al API
# ("Failed to fetch") y hace al bundle agnostico del dominio.

FROM node:20-alpine AS build

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG API_INTERNAL_URL=http://localhost:8000
ENV API_INTERNAL_URL=$API_INTERNAL_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npm run build

FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public

EXPOSE 3000

CMD ["npm", "start"]