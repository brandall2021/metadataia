# ====================================================================
# METADATAIA - Variables de entorno de PRODUCCION (FASE 18)
#
# Copiar a .env (en el servidor, NUNCA subir a Git) y completar.
# Generar los secretos con:
#   openssl rand -base64 48    (POSTGRES_PASSWORD, APP_SECRET_KEY, JWT_SECRET, MINIO_SECRET_KEY)
#   openssl rand -base64 9     (MINIO_ACCESS_KEY: legible pero aleatorio)
# El compose falla el arranque si falta POSTGRES_PASSWORD, APP_SECRET_KEY,
# JWT_SECRET, MINIO_ACCESS_KEY, MINIO_SECRET_KEY o DOMAIN.
# ====================================================================

# --- Dominio publico (Dokploy) -------------------------------------------
# Subdominio o dominio que Dokploy asigno a la aplicacion (sin https://).
DOMAIN=miapp.dominio.gob.ar

# --- Entorno / secretos --------------------------------------------------
APP_ENV=production
APP_SECRET_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# --- Base de datos -------------------------------------------------------
POSTGRES_USER=metadataia
POSTGRES_PASSWORD=
POSTGRES_DB=metadataia
POSTGRES_PORT=5433

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6380

# --- MinIO (S3) -----------------------------------------------------------
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Puertos publicados (solo si se publican en el host) --------------------
API_PORT=8001
FRONTEND_PORT=3001

# --- Reglas generales ------------------------------------------------------
DEFAULT_MAX_FILE_SIZE_MB=100
OCR_LANGUAGES=spa+eng+por
AI_TIMEOUT_SECONDS=120
DSPACE_TIMEOUT_SECONDS=120
AUTO_OCR=true
AUTO_AI=true

# --- CORS ------------------------------------------------------------------
# Lo calcula el compose desde DOMAIN (https://DOMAIN); no hace falta tocarlo.
# CORS_ORIGINS=https://miapp.dominio.gob.ar